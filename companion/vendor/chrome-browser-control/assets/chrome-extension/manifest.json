{
  "manifest_version": 3,
  "name": "Chrome Browser Control Bridge",
  "version": "0.2.0",
  "version_name": "protocol-4-upload",
  "description": "Let a local AI tool control ordinary Chrome pages through an explicit local pairing.",
  "permissions": [
    "scripting",
    "debugger",
    "tabs",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["snapshot_core.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": false
    }
  ],
  "action": {
    "default_title": "Chrome Browser Control Bridge"
  }
}
