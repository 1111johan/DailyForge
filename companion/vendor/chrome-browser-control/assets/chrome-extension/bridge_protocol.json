        "selector": { "type": "string", "default": "" },
        "exact": { "type": "bool", "default": true }
      }
    },
    "click_text": {
      "command": "click_text", "client_method": "click_text",
      "params": {
        "text": { "type": "string", "default": "" },
        "selector": { "type": "string", "default": "" },
        "exact": { "type": "bool", "default": true }
      }
    },
    "highlight": {
      "command": "highlight_selector", "client_method": "highlight_selector",
      "params": {
