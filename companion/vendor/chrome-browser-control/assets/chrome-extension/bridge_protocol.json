        "timeoutMs": { "type": "int", "default": 10000 },
        "pollMs": { "type": "int", "default": 100 },
        "frameId": { "type": "int", "default": 0 },
        "shadowPath": { "type": "json", "default": [] }
      }
    },
    "scroll": {
      "command": "scroll", "client_method": "scroll",
      "params": {
        "selector": { "type": "string", "default": "" },
