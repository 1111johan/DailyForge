      "command": "highlight_ref", "client_method": "highlight_ref",
      "params": {
        "ref": { "type": "string", "default": "" },
        "snapshot_id": { "type": "string", "default": "" },
        "duration": { "type": "int", "default": 1600 }
      }
    },
    "screenshot": { "command": "screenshot", "client_method": "screenshot", "params": {} },
