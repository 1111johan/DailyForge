        "behavior": { "type": "string", "default": "auto" },
        "block": { "type": "string", "default": "center" },
        "frameId": { "type": "int", "default": 0 },
        "shadowPath": { "type": "json", "default": [] }
      }
    },
    "press_key": {
      "command": "press_key", "client_method": "press_key",
      "params": {
        "selector": { "type": "string", "default": "" },
        "key": { "type": "string", "default": "" },
        "code": { "type": "string", "default": "" },
        "ctrl": { "type": "bool", "default": false },
        "alt": { "type": "bool", "default": false },
        "shift": { "type": "bool", "default": false },
