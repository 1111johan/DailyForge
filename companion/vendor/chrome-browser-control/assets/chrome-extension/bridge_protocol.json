      "command": "clear_selector", "client_method": "clear_selector",
      "params": {
        "selector": { "type": "string", "default": "" },
        "frameId": { "type": "int", "default": 0 },
        "shadowPath": { "type": "json", "default": [] }
      }
    },
    "focus": {
      "command": "focus_selector", "client_method": "focus_selector",
      "params": {
        "selector": { "type": "string", "default": "" },
        "frameId": { "type": "int", "default": 0 },
        "shadowPath": { "type": "json", "default": [] }
      }
    },
    "check": {
      "command": "check_selector", "client_method": "check_selector",
      "params": {
        "selector": { "type": "string", "default": "" },
        "checked": { "type": "bool", "default": true },
        "frameId": { "type": "int", "default": 0 },
        "shadowPath": { "type": "json", "default": [] }
      }
    },
    "drag_and_drop": {
      "command": "drag_and_drop", "client_method": "drag_and_drop",
