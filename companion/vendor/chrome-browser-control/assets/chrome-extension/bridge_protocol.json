        "sourceShadowPath": { "type": "json", "default": [] },
        "targetShadowPath": { "type": "json", "default": [] }
      }
    },
    "click": {
      "command": "click_selector", "client_method": "click_selector",
      "params": {
        "selector": { "type": "string", "default": "" },
        "frameId": { "type": "int", "default": 0 },
        "shadowPath": { "type": "json", "default": [] }
      }
    },
