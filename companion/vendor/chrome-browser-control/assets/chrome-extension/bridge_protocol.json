{
  "version": 4,
  "mutating_actions": [
    "open_url",
    "switch_page",
    "close_page",
    "switch_window",
    "close_window",
    "navigate",
    "click_ref",
    "highlight_ref",
    "input",
    "type_text",
    "clear",
    "focus",
    "check",
    "drag_and_drop",
    "click",
    "hover",
    "hover_text",
    "click_text",
    "highlight",
    "scroll",
    "press_key",
    "select",
    "dblclick",
    "contextmenu",
    "upload_file"
  ],
  "actions": {
    "state": { "command": "get_state", "client_method": "state", "params": {} },
    "open_url": {
      "command": "open_url", "client_method": "open_url",
      "params": {
        "url": { "type": "string", "default": "" },
        "openMode": { "type": "string", "default": "new_tab" },
        "timeoutMs": { "type": "int", "default": 20000 },
        "operationId": { "type": "string", "default": "" }
      }
    },
    "list_pages": { "command": "list_pages", "client_method": "list_pages", "params": {} },
    "switch_page": {
      "command": "switch_page", "client_method": "switch_page",
      "params": {
        "pageId": { "type": "string", "default": "" },
        "tabId": { "type": "int", "default": -1 }
      }
    },
    "close_page": {
      "command": "close_page", "client_method": "close_page",
      "params": {
        "pageId": { "type": "string", "default": "" },
        "tabId": { "type": "int", "default": -1 }
      }
    },
    "list_windows": { "command": "list_windows", "client_method": "list_windows", "params": {} },
    "switch_window": {
      "command": "switch_window", "client_method": "switch_window",
      "params": { "windowId": { "type": "int", "default": -1 } }
    },
    "close_window": {
      "command": "close_window", "client_method": "close_window",
      "params": { "windowId": { "type": "int", "default": -1 } }
    },
    "navigate": {
      "command": "navigate", "client_method": "navigate",
      "params": { "navigationAction": { "type": "string", "default": "reload" } }
    },
    "scan": {
      "command": "scan_elements", "client_method": "scan_elements",
      "params": {
        "maxTop": { "type": "int", "default": 900 },
        "offsetTop": { "type": "int", "default": 0 },
        "segmentHeight": { "type": "int", "default": 0 },
        "limit": { "type": "int", "default": 80 },
        "allFrames": { "type": "bool", "default": false },
        "includeShadow": { "type": "bool", "default": true }
      }
    },
    "find": {
      "command": "find_elements", "client_method": "find_elements",
      "params": {
        "text": { "type": "string", "default": "" },
        "exact": { "type": "bool", "default": false },
        "role": { "type": "string", "default": "" },
        "tag": { "type": "string", "default": "" },
        "attr": { "type": "object", "default": {} },
        "limit": { "type": "int", "default": 10 },
        "allFrames": { "type": "bool", "default": false },
        "includeShadow": { "type": "bool", "default": true }
      }
    },
    "extract": {
      "command": "extract_elements", "client_method": "extract_elements",
      "params": {
        "css": { "type": "string", "default": "" },
        "fields": { "type": "json", "default": ["visibleText", "href", "title", "ariaLabel"] },
        "limit": { "type": "int", "default": 100 },
        "includeHidden": { "type": "bool", "default": false },
        "allFrames": { "type": "bool", "default": false },
        "includeShadow": { "type": "bool", "default": true }
      }
    },
    "snapshot": {
      "command": "snapshot", "client_method": "snapshot",
      "params": {
        "scope": { "type": "string", "default": "viewport" },
        "within": { "type": "string", "default": "" },
        "limit": { "type": "int", "default": 120 }
      }
    },
    "inspect_point": {
      "command": "inspect_point", "client_method": "inspect_point",
      "params": {
        "x": { "type": "int", "default": 0 },
        "y": { "type": "int", "default": 0 }
      }
