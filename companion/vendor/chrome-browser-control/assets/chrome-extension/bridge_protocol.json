      "command": "hover_selector", "client_method": "hover_selector",
      "params": {
        "selector": { "type": "string", "default": "" },
        "frameId": { "type": "int", "default": 0 },
        "shadowPath": { "type": "json", "default": [] }
      }
    },
    "hover_text": {
      "command": "hover_text", "client_method": "hover_text",
